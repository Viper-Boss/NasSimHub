# Copy to the repository root as .env.fnos. Supply REAL absolute Linux paths.
# Leave these empty until dedicated directories and the secret file exist.
MODEMDECK_DATA_DIR=
MODEMDECK_RECORDINGS_DIR=
MODEMDECK_SETTINGS_KEY_FILE=

# Safe initial binding: use an SSH tunnel for the first administrator setup.
# Only change to a trusted LAN/VPN address after setting up authentication.
MODEMDECK_BIND_ADDRESS=127.0.0.1
MODEMDECK_PORT=7577
MODEMDECK_TLS_HOSTS=localhost,127.0.0.1
MODEMDECK_UID=10001
MODEMDECK_GID=10001
MODEMDECK_AGENT_GID=10002

# Use unique state volumes, not an existing ModemDeck installation's volumes.
MODEMDECK_AGENT_RUNTIME_VOLUME=nas-comm-gateway-agent-runtime
MODEMDECK_HARDWARE_STATE_VOLUME=nas-comm-gateway-hardware-state

# Empty by design: do not provision QDC507 voice binaries automatically.
# Starting the full hardware service is NOT read-only; discovery can issue AT commands.
MODEMDECK_QDC507_VOICE_RUNTIME_DIR=

# Keep the upstream empty audio bindings until the physical audio path is verified.
MODEMDECK_MEDIA_BINDINGS_FILE=./hardware/config/media-bindings.empty.json
